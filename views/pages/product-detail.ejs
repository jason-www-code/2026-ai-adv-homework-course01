<div id="app" data-product-id="<%= productId %>" v-cloak>
  <div v-if="loading" class="flex justify-center py-32">
    <div class="spinner" role="status" aria-label="載入中"></div>
  </div>

  <!-- 找不到商品 -->
  <section v-else-if="notFound" class="page-x flex flex-col items-center gap-5 py-10 text-center sm:py-12 md:gap-7 md:py-16 xl:py-20 2xl:py-24">
    <img src="/images/not-found.jpg" alt="" class="aspect-[2/1] w-full max-w-[960px] object-cover">
    <h1 class="font-display text-[34px] leading-[1.2] sm:text-[40px] md:text-5xl xl:text-[64px] 2xl:text-[72px]">找不到這束花</h1>
    <p class="max-w-[520px] text-[15px] leading-[1.7] text-mauve md:text-[17px]">這項商品可能已經移除。回到首頁看看其他花禮。</p>
    <a href="/" class="btn-primary mt-3">回到首頁</a>
  </section>

  <div v-else-if="product" class="pb-14 sm:pb-16 md:pb-20 lg:flex lg:items-start lg:gap-14 lg:px-10 lg:pt-14 lg:pb-40 xl:gap-20 xl:px-24 2xl:gap-[120px] 2xl:px-40 2xl:pt-16">
    <div class="shrink-0 lg:w-[46%] 2xl:w-[880px]">
      <img :src="product.image_url || fallbackImage" :alt="product.name" class="aspect-[8/9] w-full object-cover lg:aspect-[4/5]">
    </div>

    <div class="page-x flex min-w-0 flex-col gap-7 pt-7 sm:pt-8 md:pt-10 lg:gap-9 lg:px-0 lg:pt-6">
      <nav class="text-sm text-mauve" aria-label="麵包屑">
        <a href="/#products" class="hover:text-ivory">所有花禮</a>
        <span class="mx-2" aria-hidden="true">／</span>
        <span aria-current="page">{{ product.name }}</span>
      </nav>

      <div class="flex flex-col gap-4">
        <h1 class="font-display text-[34px] leading-[1.2] sm:text-[40px] md:text-[44px] xl:text-[52px] 2xl:text-[64px]">{{ product.name }}</h1>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <p class="text-[22px] font-medium md:text-2xl xl:text-[26px] 2xl:text-[28px]">NT$ {{ product.price.toLocaleString() }}</p>
          <p v-if="product.stock > 0" class="flex items-center gap-1.5 text-[15px] text-paid">
            <%- include('../partials/icon', { name: 'check', cls: 'h-4 w-4' }) %>
            尚有 {{ product.stock }} 件
          </p>
          <p v-else class="text-[15px] text-mauve">已售完</p>
        </div>
      </div>

      <p class="text-base leading-[1.85] text-mauve xl:text-[17px]">{{ product.description }}</p>

      <div class="flex flex-col gap-5">
        <div class="flex items-center gap-5">
          <span id="qty-label" class="text-[15px] text-mauve">數量</span>
          <div class="flex items-center rounded-[2px] border border-plum-line" role="group" aria-labelledby="qty-label">
            <button type="button" @click="decrease" :disabled="quantity <= 1" class="flex h-11 w-11 cursor-pointer items-center justify-center disabled:cursor-not-allowed disabled:opacity-40" aria-label="減少數量">
              <%- include('../partials/icon', { name: 'minus', cls: 'h-[18px] w-[18px]' }) %>
            </button>
            <span class="w-[52px] text-center font-medium" aria-live="polite">{{ quantity }}</span>
            <button type="button" @click="increase" :disabled="quantity >= product.stock" class="flex h-11 w-11 cursor-pointer items-center justify-center disabled:cursor-not-allowed disabled:opacity-40" aria-label="增加數量">
              <%- include('../partials/icon', { name: 'plus', cls: 'h-[18px] w-[18px]' }) %>
            </button>
          </div>
        </div>
        <button type="button" @click="addToCart" :disabled="adding || product.stock <= 0" class="btn-primary w-full py-5 text-[17px]">
          {{ product.stock <= 0 ? '已售完' : (adding ? '加入中…' : '加入購物車') }}
        </button>
      </div>

      <div class="flex flex-col gap-3 border-t border-plum-line pt-7">
        <h2 class="text-[15px] font-medium">購買須知</h2>
        <ul class="flex flex-col gap-3 text-sm text-mauve">
          <li>花材依季節供應，實際花束可能略有差異。</li>
          <li>台北市區可享當日配送。</li>
          <li>消費滿 NT$500 免運。</li>
        </ul>
      </div>
    </div>
  </div>
</div>
