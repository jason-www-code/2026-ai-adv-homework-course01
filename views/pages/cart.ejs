<div id="app" v-cloak>
  <div v-if="loading" class="flex justify-center py-32">
    <div class="spinner" role="status" aria-label="載入中"></div>
  </div>

  <!-- 空購物車 -->
  <section v-else-if="items.length === 0" class="page-x flex min-h-[560px] flex-col items-center justify-center gap-6 text-center xl:min-h-[720px]">
    <%- include('../partials/icon', { name: 'shopping-bag', cls: 'h-10 w-10 text-mauve xl:h-12 xl:w-12' }) %>
    <h1 class="font-display text-[32px] leading-[1.2] xl:text-5xl">購物車還是空的</h1>
    <p class="text-[15px] text-mauve xl:text-[17px]">挑一束花，送給想念的人。</p>
    <a href="/#products" class="btn-primary mt-4">挑選花束</a>
  </section>

  <section v-else class="page-x pt-7 pb-14 sm:pt-8 sm:pb-16 md:pt-10 md:pb-20 xl:pt-14 xl:pb-40 2xl:pt-16">
    <div class="mb-8 flex items-end justify-between xl:mb-12">
      <h1 class="h-page">購物車</h1>
      <p class="text-[15px] text-mauve">{{ items.length }} 項商品</p>
    </div>

    <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-14 xl:gap-16 2xl:gap-24">
      <div class="min-w-0 flex-1">
        <div class="hidden gap-8 border-b border-plum-line pb-4 text-[13px] text-mauve md:flex">
          <span class="flex-1">商品</span>
          <span class="w-[142px]">數量</span>
          <span class="w-[120px] text-right">小計</span>
          <span class="w-5"></span>
        </div>

        <div v-for="item in items" :key="item.id" class="flex items-start gap-4 border-b border-plum-line py-5 md:items-center md:gap-8 md:py-7">
          <div class="flex min-w-0 flex-1 items-start gap-4 md:items-center md:gap-6">
            <a :href="'/products/' + item.product_id" class="shrink-0">
              <img :src="item.product.image_url || fallbackImage" :alt="item.product.name" class="h-[100px] w-20 object-cover sm:h-[110px] sm:w-[88px] md:h-[120px] md:w-24 xl:h-[140px] xl:w-28 2xl:h-[150px] 2xl:w-[120px]">
            </a>
            <div class="flex min-w-0 flex-1 flex-col gap-2.5 md:gap-2">
              <a :href="'/products/' + item.product_id" class="font-display text-xl leading-[1.2] decoration-1 underline-offset-4 hover:underline md:text-2xl">{{ item.product.name }}</a>
              <p class="text-sm text-mauve">單價 NT$ {{ item.product.price.toLocaleString() }}</p>
              <div class="flex items-center justify-between pt-1.5 md:hidden">
                <div class="flex items-center rounded-[2px] border border-plum-line" role="group" :aria-label="item.product.name + ' 數量'">
                  <button type="button" @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1" class="flex h-[38px] w-[38px] cursor-pointer items-center justify-center disabled:cursor-not-allowed disabled:opacity-40" aria-label="減少數量">
                    <%- include('../partials/icon', { name: 'minus', cls: 'h-4 w-4' }) %>
                  </button>
                  <span class="w-10 text-center font-medium">{{ item.quantity }}</span>
                  <button type="button" @click="updateQuantity(item.id, item.quantity + 1)" :disabled="item.quantity >= item.product.stock" class="flex h-[38px] w-[38px] cursor-pointer items-center justify-center disabled:cursor-not-allowed disabled:opacity-40" aria-label="增加數量">
                    <%- include('../partials/icon', { name: 'plus', cls: 'h-4 w-4' }) %>
                  </button>
                </div>
                <p class="font-medium">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</p>
              </div>
            </div>
          </div>

          <div class="hidden w-[142px] md:block">
            <div class="inline-flex items-center rounded-[2px] border border-plum-line" role="group" :aria-label="item.product.name + ' 數量'">
              <button type="button" @click="updateQuantity(item.id, item.quantity - 1)" :disabled="item.quantity <= 1" class="flex h-11 w-11 cursor-pointer items-center justify-center disabled:cursor-not-allowed disabled:opacity-40" aria-label="減少數量">
                <%- include('../partials/icon', { name: 'minus', cls: 'h-[18px] w-[18px]' }) %>
              </button>
              <span class="w-[52px] text-center font-medium">{{ item.quantity }}</span>
              <button type="button" @click="updateQuantity(item.id, item.quantity + 1)" :disabled="item.quantity >= item.product.stock" class="flex h-11 w-11 cursor-pointer items-center justify-center disabled:cursor-not-allowed disabled:opacity-40" aria-label="增加數量">
                <%- include('../partials/icon', { name: 'plus', cls: 'h-[18px] w-[18px]' }) %>
              </button>
            </div>
          </div>
          <p class="hidden w-[120px] text-right text-lg font-medium md:block">NT$ {{ (item.product.price * item.quantity).toLocaleString() }}</p>
          <button type="button" @click="confirmDelete(item.id)" class="cursor-pointer text-mauve transition-colors hover:text-failed" :aria-label="'移除 ' + item.product.name">
            <%- include('../partials/icon', { name: 'trash-2', cls: 'h-5 w-5' }) %>
          </button>
        </div>

        <p v-if="total >= 500" class="flex items-center gap-2 pt-6 text-sm text-paid">
          <%- include('../partials/icon', { name: 'truck', cls: 'h-[18px] w-[18px]' }) %>
          已達 NT$500 免運門檻
        </p>
        <p v-else class="flex items-center gap-2 pt-6 text-sm text-pending">
          <%- include('../partials/icon', { name: 'truck', cls: 'h-[18px] w-[18px]' }) %>
          再買 NT$ {{ (500 - total).toLocaleString() }} 即可免運
        </p>
      </div>

      <!-- 訂單摘要（象牙紙面） -->
      <aside class="theme-paper flex flex-col gap-5 bg-paper p-7 text-paper-ink sm:p-10 lg:w-[380px] xl:w-[400px] 2xl:w-[480px]" aria-labelledby="summary-title">
        <h2 id="summary-title" class="font-display text-2xl leading-[1.2] sm:text-[28px]">訂單摘要</h2>
        <div class="flex items-center justify-between text-[15px]">
          <span class="text-paper-ink-2">商品小計</span>
          <span>NT$ {{ total.toLocaleString() }}</span>
        </div>
        <div class="flex items-center justify-between text-[15px]">
          <span class="text-paper-ink-2">運費</span>
          <span>{{ total >= 500 ? '免運' : 'NT$ 150' }}</span>
        </div>
        <div class="flex items-center justify-between border-t border-paper-line pt-5">
          <span class="font-medium">總計</span>
          <span class="text-[26px] font-bold">NT$ {{ (total + (total >= 500 ? 0 : 150)).toLocaleString() }}</span>
        </div>
        <button type="button" @click="goCheckout" class="btn-paper w-full py-[18px]">前往結帳</button>
        <p v-if="!loggedIn" class="text-[13px] text-paper-ink-2">結帳前需要先登入會員。</p>
      </aside>
    </div>
  </section>

  <!-- 移除確認：桌機置中，手機為底部抽屜 -->
  <div v-if="confirmVisible" class="fixed inset-0 z-[80] flex items-end justify-center sm:items-center" role="dialog" aria-modal="true" aria-labelledby="remove-title">
    <div class="absolute inset-0 bg-[#1A0F16]/70" @click="confirmVisible = false"></div>
    <div class="theme-paper relative flex w-full flex-col gap-5 bg-paper px-5 pt-8 pb-9 text-paper-ink shadow-[0_24px_64px_rgba(0,0,0,0.4)] sm:mx-6 sm:max-w-[480px] sm:gap-6 sm:p-10">
      <h3 id="remove-title" class="font-display text-2xl leading-[1.2] sm:text-[28px]">要移除這項商品嗎？</h3>
      <p class="text-[15px] leading-[1.7] text-paper-ink-2">「{{ deleteItemName }}」會從購物車中移除。</p>
      <div class="flex flex-col-reverse gap-3 pt-2 sm:flex-row sm:justify-end">
        <button type="button" @click="confirmVisible = false" class="btn-paper-outline w-full sm:w-auto">取消</button>
        <button type="button" @click="handleDelete" class="btn-danger w-full sm:w-auto">移除</button>
      </div>
    </div>
  </div>
</div>
