<div id="app" v-cloak class="flex flex-col gap-5 md:gap-7">
  <div class="flex items-center justify-between gap-4">
    <div class="flex flex-col gap-1.5">
      <h1 class="font-display text-[28px] leading-[1.2] sm:text-[30px] md:text-[34px] xl:text-[40px] 2xl:text-[44px]">商品管理</h1>
      <p v-if="!loading" class="text-sm text-paper-ink-2">共 {{ pagination.total }} 項商品</p>
    </div>
    <button type="button" @click="openCreate" class="btn-paper px-[18px] py-3 text-[15px] md:px-6 md:py-3.5">
      <%- include('../../partials/icon', { name: 'plus', cls: 'h-4 w-4' }) %>
      新增商品
    </button>
  </div>

  <div v-if="loading" class="flex justify-center py-16">
    <div class="spinner-paper" role="status" aria-label="載入中"></div>
  </div>

  <template v-else>
    <div v-if="products.length === 0" class="border border-paper-line bg-white px-6 py-16 text-center text-paper-ink-2">
      還沒有商品，按「新增商品」建立第一項。
    </div>

    <div v-else class="border border-paper-line bg-white">
      <!-- 768 以上：表格 -->
      <table class="hidden w-full text-[15px] md:table">
        <thead>
          <tr class="bg-paper-sunk text-[13px] text-paper-ink-2">
            <th class="px-4 py-3.5 whitespace-nowrap xl:px-6 text-left font-medium">商品</th>
            <th class="w-[100px] px-4 py-3.5 whitespace-nowrap xl:px-6 text-right font-medium xl:w-[140px]">價格</th>
            <th class="w-16 px-4 py-3.5 whitespace-nowrap xl:px-6 text-right font-medium xl:w-[100px]">庫存</th>
            <th class="w-[72px] px-4 py-3.5 whitespace-nowrap xl:px-6 text-right font-medium xl:w-[150px]">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="product in products" :key="product.id" class="border-t border-paper-line">
            <td class="px-4 py-3 whitespace-nowrap xl:px-6">
              <div class="flex items-center gap-4">
                <img :src="product.image_url || fallbackImage" :alt="product.name" class="h-[60px] w-12 shrink-0 object-cover">
                <span class="font-medium">{{ product.name }}</span>
              </div>
            </td>
            <td class="px-4 py-3 whitespace-nowrap xl:px-6 text-right">NT$ {{ product.price.toLocaleString() }}</td>
            <td class="px-4 py-3 whitespace-nowrap xl:px-6 text-right">{{ product.stock }}</td>
            <td class="px-4 py-3 whitespace-nowrap xl:px-6">
              <div class="flex items-center justify-end gap-4 xl:gap-5">
                <button type="button" @click="openEdit(product)" class="cursor-pointer text-sm font-medium" :aria-label="'編輯 ' + product.name">
                  <span class="hidden underline underline-offset-4 xl:inline">編輯</span>
                  <%- include('../../partials/icon', { name: 'pencil', cls: 'h-[18px] w-[18px] xl:hidden' }) %>
                </button>
                <button type="button" @click="confirmDeleteFn(product)" class="cursor-pointer text-sm font-medium text-failed-ink" :aria-label="'刪除 ' + product.name">
                  <span class="hidden xl:inline">刪除</span>
                  <%- include('../../partials/icon', { name: 'trash-2', cls: 'h-[18px] w-[18px] xl:hidden' }) %>
                </button>
              </div>
            </td>
          </tr>
        </tbody>
      </table>

      <!-- 768 以下：堆疊列 -->
      <ul class="md:hidden">
        <li v-for="(product, idx) in products" :key="product.id" class="flex items-center gap-3.5 px-4 py-3.5" :class="{ 'border-t border-paper-line': idx > 0 }">
          <img :src="product.image_url || fallbackImage" :alt="product.name" class="h-[65px] w-[52px] shrink-0 object-cover">
          <div class="flex min-w-0 flex-1 flex-col gap-1.5">
            <span class="text-[15px] font-medium">{{ product.name }}</span>
            <span class="text-[13px] text-paper-ink-2">NT$ {{ product.price.toLocaleString() }}<span class="mx-2" aria-hidden="true"></span>庫存 {{ product.stock }}</span>
          </div>
          <div class="flex items-center gap-[18px]">
            <button type="button" @click="openEdit(product)" class="cursor-pointer" :aria-label="'編輯 ' + product.name">
              <%- include('../../partials/icon', { name: 'pencil', cls: 'h-[18px] w-[18px]' }) %>
            </button>
            <button type="button" @click="confirmDeleteFn(product)" class="cursor-pointer text-failed-ink" :aria-label="'刪除 ' + product.name">
              <%- include('../../partials/icon', { name: 'trash-2', cls: 'h-[18px] w-[18px]' }) %>
            </button>
          </div>
        </li>
      </ul>
    </div>

    <nav v-if="pagination.totalPages > 1" class="flex gap-2" aria-label="商品分頁">
      <button
        v-for="p in pagination.totalPages"
        :key="p"
        type="button"
        @click="loadProducts(p)"
        :aria-current="p === pagination.page ? 'page' : null"
        class="h-11 w-11 cursor-pointer rounded-[2px] text-[15px] font-medium"
        :class="p === pagination.page ? 'bg-paper-ink text-ivory' : 'border border-paper-line bg-white hover:border-paper-ink'"
      >{{ p }}</button>
    </nav>
  </template>

  <!-- 新增／編輯商品：桌機置中，手機為底部抽屜 -->
  <div v-if="modalVisible" class="fixed inset-0 z-[80] flex items-end justify-center md:items-center" role="dialog" aria-modal="true" aria-labelledby="product-modal-title">
    <div class="absolute inset-0 bg-[#1A0F16]/70" @click="modalVisible = false"></div>
    <div class="relative max-h-[92vh] w-full overflow-y-auto bg-paper px-5 pt-7 pb-8 shadow-[0_24px_64px_rgba(0,0,0,0.4)] md:mx-6 md:max-w-[560px] md:p-10">
      <h2 id="product-modal-title" class="mb-6 font-display text-2xl leading-[1.2] md:text-[28px]">{{ editingProduct ? '編輯商品' : '新增商品' }}</h2>
      <form @submit.prevent="handleSave" class="flex flex-col gap-[18px] md:gap-6">
        <div>
          <label for="product-name" class="field-label-paper">商品名稱 *</label>
          <input id="product-name" v-model="form.name" type="text" class="field-paper">
        </div>
        <div>
          <label for="product-description" class="field-label-paper">商品描述</label>
          <textarea id="product-description" v-model="form.description" rows="4" class="field-paper h-auto py-3.5 leading-[1.6]"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="product-price" class="field-label-paper">價格 *</label>
            <input id="product-price" v-model.number="form.price" type="number" min="1" class="field-paper">
          </div>
          <div>
            <label for="product-stock" class="field-label-paper">庫存 *</label>
            <input id="product-stock" v-model.number="form.stock" type="number" min="0" class="field-paper">
          </div>
        </div>
        <div>
          <label for="product-image" class="field-label-paper">圖片網址</label>
          <input id="product-image" v-model="form.image_url" type="text" class="field-paper">
        </div>
        <div class="flex flex-col-reverse gap-3 pt-2 md:flex-row md:justify-end">
          <button type="button" @click="modalVisible = false" class="btn-paper-outline w-full md:w-auto">取消</button>
          <button type="submit" :disabled="saving" class="btn-paper w-full md:w-auto">{{ saving ? '儲存中…' : '儲存' }}</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 刪除確認 -->
  <div v-if="confirmVisible" class="fixed inset-0 z-[80] flex items-end justify-center md:items-center" role="dialog" aria-modal="true" aria-labelledby="delete-title">
    <div class="absolute inset-0 bg-[#1A0F16]/70" @click="confirmVisible = false"></div>
    <div class="relative flex w-full flex-col gap-5 bg-paper px-5 pt-7 pb-8 shadow-[0_24px_64px_rgba(0,0,0,0.4)] md:mx-6 md:max-w-[480px] md:gap-6 md:p-10">
      <h2 id="delete-title" class="font-display text-[22px] leading-[1.3] md:text-[26px]">要刪除「{{ deleteName }}」嗎？</h2>
      <p class="text-[15px] leading-[1.7] text-paper-ink-2">刪除後無法復原。仍有待付款訂單的商品不能刪除。</p>
      <div class="flex flex-col-reverse gap-3 pt-2 md:flex-row md:justify-end">
        <button type="button" @click="confirmVisible = false" class="btn-paper-outline w-full md:w-auto">取消</button>
        <button type="button" @click="handleDelete" class="btn-danger w-full md:w-auto">刪除</button>
      </div>
    </div>
  </div>
</div>
