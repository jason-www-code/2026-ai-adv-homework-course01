<div id="app" v-cloak>
  <!-- Hero：桌機為滿版暗調靜物＋左側文字；1024 以下改為圖上文下 -->
  <section class="relative overflow-hidden" aria-labelledby="hero-title">
    <div class="relative h-[420px] bg-cover bg-center sm:h-[520px] md:h-[640px] lg:hidden" style="background-image: url('/images/hero.jpg');">
      <div class="absolute inset-0 bg-linear-to-t from-plum-night to-transparent to-40%"></div>
    </div>
    <div class="absolute inset-0 hidden bg-cover bg-[position:70%_center] lg:block" style="background-image: url('/images/hero-wide.jpg');"></div>
    <div class="absolute inset-0 hidden bg-linear-to-r from-plum-night/95 via-plum-night/60 via-35% to-transparent to-60% lg:block"></div>
    <div class="page-x relative pt-2 pb-16 md:pb-20 lg:flex lg:h-[680px] lg:items-center lg:py-0 xl:h-[760px] 2xl:h-[880px]">
      <div class="flex max-w-[620px] flex-col gap-7 lg:gap-10 2xl:max-w-[760px]">
        <h1 id="hero-title" class="font-display text-[44px] leading-[1.2] sm:text-[56px] md:text-[64px] lg:text-[80px] xl:text-[96px] 2xl:text-[120px]">今天想送誰<br>一束花？</h1>
        <p class="text-base leading-[1.75] text-mauve sm:text-[17px] md:text-lg 2xl:text-xl">花藝師當天手綁，台北市區當日送達；<br class="hidden lg:inline">滿 NT$500 免運。</p>
        <div>
          <a href="#products" class="btn-primary w-full sm:w-auto 2xl:px-11 2xl:py-5 2xl:text-[17px]">挑選花束</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 本季精選：1 大 + 3 小 -->
  <section v-if="featured.length" class="page-x py-[72px] sm:py-20 md:py-24 xl:py-[120px] 2xl:pt-40 2xl:pb-[140px]" aria-labelledby="featured-title">
    <div class="mb-10 flex flex-col gap-2.5 md:flex-row md:items-end md:justify-between xl:mb-16">
      <h2 id="featured-title" class="h-section">本季精選</h2>
      <p class="text-[15px] text-mauve 2xl:text-base">本季最常被指定的四款花禮。</p>
    </div>
    <div class="flex flex-col gap-10 lg:flex-row xl:gap-14 2xl:gap-20">
      <a :href="'/products/' + featured[0].id" class="group block shrink-0 lg:w-[48%] 2xl:w-[820px]">
        <div class="aspect-[4/5] overflow-hidden bg-plum-raised">
          <img :src="featured[0].image_url || fallbackImage" :alt="featured[0].name" class="h-full w-full object-cover">
        </div>
        <div class="mt-5 flex items-end justify-between gap-6 xl:mt-7">
          <div class="min-w-0">
            <h3 class="font-display text-[26px] leading-[1.2] decoration-1 underline-offset-4 group-hover:underline md:text-[30px] xl:text-[32px] 2xl:text-[40px]">{{ featured[0].name }}</h3>
            <p class="mt-2 line-clamp-1 text-sm text-mauve md:text-base">{{ featured[0].description }}</p>
          </div>
          <p class="text-lg font-medium whitespace-nowrap xl:text-[22px]">NT$ {{ featured[0].price.toLocaleString() }}</p>
        </div>
      </a>
      <div class="flex flex-1 flex-col gap-7 xl:gap-10 2xl:gap-12">
        <a v-for="p in featured.slice(1)" :key="p.id" :href="'/products/' + p.id" class="group flex items-center gap-4 sm:gap-7 xl:gap-8 2xl:gap-10">
          <div class="aspect-[4/5] w-28 shrink-0 overflow-hidden bg-plum-raised sm:w-[136px] md:w-44 xl:w-48 2xl:w-64">
            <img :src="p.image_url || fallbackImage" :alt="p.name" loading="lazy" class="h-full w-full object-cover">
          </div>
          <div class="flex min-w-0 flex-col gap-2 xl:gap-3.5">
            <h3 class="font-display text-xl leading-[1.2] decoration-1 underline-offset-4 group-hover:underline sm:text-[22px] md:text-2xl xl:text-[26px] 2xl:text-[32px]">{{ p.name }}</h3>
            <p class="line-clamp-2 text-sm leading-[1.7] text-mauve 2xl:text-base">{{ p.description }}</p>
            <p class="text-base font-medium 2xl:text-lg">NT$ {{ p.price.toLocaleString() }}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- 品牌故事 -->
  <section id="story" class="scroll-mt-16 bg-plum-raised md:scroll-mt-20 xl:scroll-mt-24" aria-labelledby="story-title">
    <div class="lg:flex lg:items-center lg:gap-16 lg:px-10 xl:gap-20 xl:px-24 2xl:gap-[120px] 2xl:px-40">
      <div class="shrink-0 lg:w-[44%] 2xl:w-[720px]">
        <img src="/images/story.jpg" alt="花藝師在工作台上綁花束" loading="lazy" class="h-[400px] w-full object-cover sm:h-[440px] md:h-[560px] lg:aspect-[4/5] lg:h-auto">
      </div>
      <div class="page-x flex max-w-[640px] flex-col gap-6 pt-12 pb-[72px] sm:pb-20 md:pb-24 lg:gap-9 lg:px-0 lg:py-24">
        <h2 id="story-title" class="h-section">專心，<br>做好一束花。</h2>
        <p class="text-base leading-[1.85] text-mauve xl:text-lg">花漾生活成立於 2020 年，我們相信每一朵花都有自己的故事。透過專業花藝師的巧手，將大自然的美好帶進您的日常生活中。</p>
        <p class="font-display text-xl leading-[1.5] md:text-[22px] xl:text-[28px]">「每一束花，都是一份用心的禮物。」</p>
      </div>
    </div>
  </section>

  <!-- 所有花禮 -->
  <section id="products" class="page-x scroll-mt-16 py-[72px] sm:py-20 md:scroll-mt-20 md:py-24 xl:scroll-mt-24 xl:pt-[120px] xl:pb-24 2xl:pt-40 2xl:pb-[120px]" aria-labelledby="products-title">
    <div class="mb-7 flex items-end justify-between sm:mb-10 xl:mb-16">
      <h2 id="products-title" class="h-section">所有花禮</h2>
      <p v-if="!loading && pagination.total" class="text-sm text-mauve 2xl:text-base">共 {{ pagination.total }} 項</p>
    </div>

    <div v-if="loading" class="flex justify-center py-16">
      <div class="spinner" role="status" aria-label="載入中"></div>
    </div>

    <template v-else>
      <div v-if="products.length === 0" class="flex flex-col items-center gap-3 py-16 text-center">
        <p class="font-display text-[28px]">目前沒有商品</p>
        <p class="text-mauve">請稍後再來看看。</p>
      </div>

      <div v-else class="grid grid-cols-2 gap-x-3 gap-y-10 sm:gap-x-4 md:grid-cols-3 md:gap-x-5 xl:gap-x-8 xl:gap-y-16 2xl:gap-x-12">
        <article v-for="product in products" :key="product.id" class="flex flex-col gap-3.5 xl:gap-5">
          <a :href="'/products/' + product.id" class="block aspect-[4/5] overflow-hidden bg-plum-raised" :aria-label="product.name">
            <img :src="product.image_url || fallbackImage" :alt="product.name" loading="lazy" class="h-full w-full object-cover" :class="{ 'opacity-45': product.stock <= 0 }">
          </a>
          <div class="flex flex-col gap-2.5 xl:gap-3">
            <h3 class="font-display text-lg leading-[1.2] sm:text-xl xl:text-2xl">
              <a :href="'/products/' + product.id" class="decoration-1 underline-offset-4 hover:underline">{{ product.name }}</a>
            </h3>
            <div class="flex flex-col items-start gap-3 xl:flex-row xl:items-center xl:justify-between">
              <p class="text-[15px] font-medium xl:text-base" :class="product.stock <= 0 ? 'text-mauve' : 'text-ivory'">NT$ {{ product.price.toLocaleString() }}</p>
              <button
                type="button"
                @click="addToCart(product)"
                :disabled="product._adding || product.stock <= 0"
                class="inline-flex w-full cursor-pointer items-center justify-center gap-1.5 rounded-[2px] border border-plum-line px-3.5 py-2 text-sm transition-colors hover:border-ivory disabled:cursor-not-allowed disabled:text-mauve disabled:hover:border-plum-line xl:w-auto"
              >
                <%- include('../partials/icon', { name: 'plus', cls: 'h-4 w-4', attrs: 'v-if="product.stock > 0"' }) %>
                {{ product.stock <= 0 ? '已售完' : (product._adding ? '加入中…' : '加入購物車') }}
              </button>
            </div>
          </div>
        </article>
      </div>

      <nav v-if="pagination.totalPages > 1" class="mt-12 flex gap-2 xl:mt-16" aria-label="商品分頁">
        <button
          v-for="p in pagination.totalPages"
          :key="p"
          type="button"
          @click="loadProducts(p)"
          :aria-current="p === pagination.page ? 'page' : null"
          class="h-11 w-11 cursor-pointer rounded-[2px] text-[15px] font-medium transition-colors"
          :class="p === pagination.page ? 'bg-marigold text-plum-night' : 'border border-plum-line hover:border-ivory'"
        >{{ p }}</button>
      </nav>
    </template>
  </section>

  <!-- 顧客評價 -->
  <section class="page-x border-t border-plum-line py-[72px] sm:py-20 md:py-24 xl:py-28 2xl:py-[140px]" aria-labelledby="reviews-title">
    <h2 id="reviews-title" class="h-section mb-10 xl:mb-[72px]">收到花的人怎麼說</h2>
    <div class="flex flex-col gap-10 lg:flex-row lg:gap-16 2xl:gap-24">
      <figure v-for="r in reviews" :key="r.name" class="flex flex-1 flex-col gap-4 xl:gap-7">
        <blockquote class="font-display text-xl leading-[1.6] md:text-[22px] xl:text-2xl 2xl:text-[28px]">「{{ r.text }}」</blockquote>
        <figcaption class="text-sm font-medium text-mauve 2xl:text-[15px]">{{ r.name }}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 服務 -->
  <section class="page-x flex flex-col gap-7 border-t border-plum-line py-14 lg:flex-row lg:gap-16 xl:py-[72px] 2xl:gap-24" aria-label="服務說明">
    <div class="flex flex-1 items-start gap-4 xl:gap-5">
      <%- include('../partials/icon', { name: 'truck', cls: 'h-6 w-6 shrink-0 xl:h-7 xl:w-7' }) %>
      <div class="flex flex-col gap-1.5 xl:gap-2">
        <p class="font-medium xl:text-lg">台北市區當日配送</p>
        <p class="text-sm text-mauve xl:text-[15px]">下單當天由專人送達。</p>
      </div>
    </div>
    <div class="flex flex-1 items-start gap-4 xl:gap-5">
      <%- include('../partials/icon', { name: 'gift', cls: 'h-6 w-6 shrink-0 xl:h-7 xl:w-7' }) %>
      <div class="flex flex-col gap-1.5 xl:gap-2">
        <p class="font-medium xl:text-lg">花藝師手工包裝</p>
        <p class="text-sm text-mauve xl:text-[15px]">每束花都經過精心包裝。</p>
      </div>
    </div>
    <div class="flex flex-1 items-start gap-4 xl:gap-5">
      <%- include('../partials/icon', { name: 'badge-check', cls: 'h-6 w-6 shrink-0 xl:h-7 xl:w-7' }) %>
      <div class="flex flex-col gap-1.5 xl:gap-2">
        <p class="font-medium xl:text-lg">滿 NT$500 免運</p>
        <p class="text-sm text-mauve xl:text-[15px]">消費滿 NT$500 免運費。</p>
      </div>
    </div>
  </section>
</div>
