<!DOCTYPE html>
<html lang="zh-TW">
<%- include('../partials/head') %>
<body class="theme-paper min-h-screen bg-paper text-paper-ink">
  <a href="#main" class="sr-only z-[70] bg-paper-ink px-4 py-2 text-ivory focus:not-sr-only focus:fixed focus:top-2 focus:left-2">跳到主要內容</a>
  <div class="flex min-h-screen flex-col md:flex-row">
    <%- include('../partials/admin-sidebar') %>
    <div class="flex min-w-0 flex-1 flex-col">
      <%- include('../partials/admin-header') %>
      <main id="main" class="flex-1 px-5 pt-7 pb-12 sm:px-6 md:px-8 md:py-11 xl:px-10 2xl:px-14">
        <%- body %>
      </main>
    </div>
  </div>
  <%- include('../partials/notification') %>

  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>
  <script src="/js/auth.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/notification.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      if (!Auth.requireAdmin()) return;
      var el = document.getElementById('admin-username');
      if (el) el.textContent = Auth.getUser()?.name || '';
    });
  </script>
  <% if (typeof pageScript !== 'undefined' && pageScript) { %>
  <script src="/js/pages/<%= pageScript %>.js"></script>
  <% } %>
</body>
</html>
