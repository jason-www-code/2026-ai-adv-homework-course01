<header class="hidden h-[72px] items-center justify-between border-b border-paper-line px-8 md:flex xl:px-10 2xl:px-14">
  <p class="text-sm text-paper-ink-2">管理後台<span class="mx-3" aria-hidden="true">／</span><%= typeof title !== 'undefined' ? title : '' %></p>
  <div class="flex items-center gap-6 text-sm">
    <span class="flex items-center gap-2 font-medium">
      <%- include('icon', { name: 'circle-user-round', cls: 'h-5 w-5' }) %>
      <span id="admin-username"></span>
    </span>
    <button type="button" onclick="Auth.logout()" class="cursor-pointer text-paper-ink-2 hover:text-paper-ink">登出</button>
  </div>
</header>
