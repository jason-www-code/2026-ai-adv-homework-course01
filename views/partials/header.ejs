<header class="sticky top-0 z-50 border-b border-plum-line bg-plum-night">
  <div class="page-x flex h-16 items-center justify-between md:h-20 xl:h-24">
    <div class="flex items-center gap-8 xl:gap-16">
      <a href="/" class="font-display text-[22px] leading-none text-ivory md:text-[26px] xl:text-[30px]">花漾生活</a>
      <nav class="hidden items-center gap-6 text-mauve md:flex xl:gap-10" aria-label="主要導覽">
        <a href="/#products" class="transition-colors hover:text-ivory">所有花禮</a>
        <a href="/#story" class="transition-colors hover:text-ivory">品牌故事</a>
        <a href="/orders" data-auth="user" class="transition-colors hover:text-ivory" hidden>我的訂單</a>
        <a href="/admin/products" data-auth="admin" class="transition-colors hover:text-ivory" hidden>後台管理</a>
      </nav>
    </div>

    <div class="flex items-center gap-5 md:gap-6 xl:gap-8">
      <div class="hidden items-center gap-6 md:flex xl:gap-8">
        <a href="/login" data-auth="guest" class="font-medium transition-colors hover:text-marigold">登入</a>
        <span data-auth="user" data-user-name class="hidden font-medium lg:inline" hidden></span>
        <button type="button" data-auth="user" data-logout class="cursor-pointer text-mauve transition-colors hover:text-ivory" hidden>登出</button>
      </div>
      <a href="/cart" class="flex items-center gap-2.5 font-medium" aria-label="購物車">
        <%- include('icon', { name: 'shopping-bag', cls: 'h-[22px] w-[22px]' }) %>
        <span class="hidden lg:inline">購物車</span>
        <span data-cart-badge class="flex h-5 min-w-5 items-center justify-center rounded-full bg-ivory px-1.5 text-[11px] font-bold text-plum-night md:h-6 md:min-w-6 md:text-xs" hidden></span>
      </a>
      <button type="button" id="menu-open" class="cursor-pointer md:hidden" aria-label="開啟選單" aria-controls="mobile-menu" aria-expanded="false">
        <%- include('icon', { name: 'menu', cls: 'h-6 w-6' }) %>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="fixed inset-0 z-[60] flex flex-col overflow-y-auto bg-plum-night md:hidden" role="dialog" aria-modal="true" aria-label="選單" hidden>
    <div class="page-x flex h-16 shrink-0 items-center justify-between border-b border-plum-line">
      <a href="/" class="font-display text-[22px] leading-none">花漾生活</a>
      <button type="button" id="menu-close" class="cursor-pointer" aria-label="關閉選單">
        <%- include('icon', { name: 'x', cls: 'h-6 w-6' }) %>
      </button>
    </div>
    <nav class="page-x flex flex-col py-4" aria-label="選單導覽">
      <% [['/#products', '所有花禮', ''], ['/#story', '品牌故事', ''], ['/cart', '購物車', ''], ['/orders', '我的訂單', 'user'], ['/admin/products', '後台管理', 'admin']].forEach(function (item) { %>
      <a href="<%= item[0] %>" class="flex items-center justify-between border-b border-plum-line py-[22px]"<% if (item[2]) { %> data-auth="<%= item[2] %>" hidden<% } %>>
        <span class="font-display text-[28px] leading-none"><%= item[1] %></span>
        <%- include('icon', { name: 'chevron-right', cls: 'h-5 w-5 text-mauve' }) %>
      </a>
      <% }) %>
    </nav>
    <div class="page-x flex flex-col gap-3 py-6">
      <p data-auth="guest" class="text-sm text-mauve">登入後可以結帳與查看訂單。</p>
      <a href="/login" data-auth="guest" class="btn-outline w-full">登入／註冊</a>
      <p data-auth="user" class="text-sm text-mauve" hidden>目前登入：<span data-user-name class="text-ivory"></span></p>
      <button type="button" data-auth="user" data-logout class="btn-outline w-full" hidden>登出</button>
    </div>
  </div>
</header>
