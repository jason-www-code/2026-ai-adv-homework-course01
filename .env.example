# ECPay（以下為綠界官方公開測試帳號）
# ECPAY_ENV 只接受 staging 或 production，其他值會讓伺服器無法啟動。
# production 必須換成自己的特店金鑰；缺少任一個或仍是測試帳號時，伺服器會直接結束。
# staging 可把三個金鑰全部拿掉改用測試帳號，但不可只設其中一部分。
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_ENV=staging